# ---------- Core ----------
APP_NAME=ChatMood
JWT_SECRET=replace-with-a-long-random-string
DATABASE_URL=postgresql+asyncpg://mood:mood@localhost:5432/mood
REDIS_URL=redis://localhost:6379/0
# Vector store: with QDRANT_URL unset/localhost (default) memory/recall/doc-RAG run on
# pgvector INSIDE the DATABASE above — zero extra infra. Point it at a real Qdrant
# server (or set VECTOR_BACKEND=qdrant) to use Qdrant instead.
QDRANT_URL=http://localhost:6333
VECTOR_BACKEND=auto          # auto | pgvector | qdrant
EMBED_PROVIDER=auto          # auto | gemini | fastembed | openai — auto prefers Gemini when GEMINI_API_KEY is set
GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional SECOND Google key just for embeddings (separate daily quota)
GEMINI_EMBED_API_KEY=
# Any OpenAI-compatible embeddings endpoint as the middle rescue tier (pre-ONNX)
# e.g. Cloudflare Workers AI: base https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1
# model @cf/baai/bge-small-en-v1.5 (384-dim, free 10k neurons/day)
EMBED_API_KEY=
EMBED_API_BASE_URL=
EMBED_API_MODEL=text-embedding-3-small
# Pause fact extraction + title prettifier (daily-budget shield for tiny LLM keys)
QUOTA_ECONOMY=false
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./storage

# ---------- xAI / Grok (REQUIRED) ----------
# Get a key at https://console.x.ai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
MODEL_CHAT=grok-4
MODEL_FAST=grok-3-mini
MODEL_VISION=grok-2-vision-1212
MODEL_IMAGE=grok-2-image-1212
# Free image engines, tried LEFT→RIGHT when xAI image gen fails or is unfunded.
# Comma-separated cascade. With XAI_API_KEY unset, the FIRST entry is the engine.
#   pollinations  — free FLUX images, NO API KEY at all (unlimited-ish, ~2s)
#   gemini        — Gemini image models, free daily quota in AI Studio (reuses GEMINI_API_KEY)
#   huggingface   — HF Inference free daily credits (set HF_API_TOKEN, free at huggingface.co)
#   cloudflare    — Workers AI free 10k neurons/day (set WORKERS_AI_*; else reuses CLOUDFLARE_*)
# Unconfigured / over-quota / failing engines are skipped to the next automatically.
IMAGE_FALLBACK_PROVIDER=pollinations
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# HF_API_TOKEN=                        # free token → huggingface.co/settings/tokens
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# WORKERS_AI_ACCOUNT_ID=               # dash.cloudflare.com → Workers AI
# WORKERS_AI_API_TOKEN=
# WORKERS_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Archive every generated image to durable storage (uses the R2_* creds below when set)
IMAGE_PERSIST=true
IMAGE_PERSIST_TTL_S=604800

# ---------- Brain cascade (optional extra tiers — zero code to add a provider) ----------
# 🥈 FreeTheAi-format slot — any OpenAI-compatible gateway fits here (OpenRouter
# :free models, FreeTheAi, etc). Production currently points at OpenRouter:
#   FREETHEAI_BASE_URL=https://openrouter.ai/api/v1
#   FREETHEAI_MODEL=google/gemma-4-31b-it:free  (fast: google/gemma-4-26b-a4b-it:free)
FREETHEAI_API_KEY=
FREETHEAI_BASE_URL=https://api.freetheai.xyz/v1
FREETHEAI_MODEL=
FREETHEAI_MODEL_FAST=
# 🧬 Generic extra brain: Groq (console.groq.com), Cerebras, Mistral, OpenRouter (:free),
# or Cloudflare Workers AI (base https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1)
EXTRA_BRAIN_API_KEY=
EXTRA_BRAIN_BASE_URL=https://api.groq.com/openai/v1
EXTRA_BRAIN_MODEL=
EXTRA_BRAIN_MODEL_FAST=

# ---------- Ops ----------
# 💓 keep the Neon compute hot (a SELECT 1 every 240s; false = allow idle suspension)
DB_KEEP_WARM=true
DB_KEEP_WARM_S=240

# ---------- Multi-provider router (optional; xAI is the default for everything) ----------
# Any OpenAI-compatible endpoint. Routing away from xAI needs BOTH the provider key
# AND a ROUTE_MODEL_* override, otherwise it safely falls back to xAI.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Claude path: point OPENAI_BASE_URL at an OpenAI-compat gateway (e.g. LiteLLM) & set PROVIDER_*=openai
PROVIDER_CHAT=xai
PROVIDER_CODING=xai
PROVIDER_AGENTS=xai
PROVIDER_DEEPSEARCH=xai
# ROUTE_MODEL_CODING=gemini-2.5-pro
# ROUTE_MODEL_AGENTS=gpt-4o
# ROUTE_MODEL_DEEPSEARCH=
# ROUTE_MODEL_CHAT=

# ---------- Web search ----------
# xai_live = built-in xAI Live Search (default, no extra key)
# tavily   = classic retrieval injected as context
SEARCH_PROVIDER=xai_live
TAVILY_API_KEY=

# ---------- Voice (Whisper STT + TTS) - optional, required for voice features ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ---------- Stripe subscriptions (optional) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---------- Custom domains (connect own + real-time purchase) ----------
# Platform DNS: users CNAME their custom domains to this host (your edge proxy domain)
PLATFORM_CNAME_TARGET=
# Apex IP for purchased domains (auto-configured after checkout; optional)
PLATFORM_A_RECORD_IP=
# Your margin on top of registrar cost price (%)
DOMAIN_MARKUP_PCT=20
# Registrar API (developer.godaddy.com/keys). "ote" = sandbox (test the full
# purchase flow for free) → "production" = real registrations & charges.
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_ENV=ote
# Optional: auto-attach verified/purchased domains to your Vercel project
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional: one-tap DNS setup for BYO domains already hosted on Cloudflare.
# Token scopes: Zone:Read + DNS:Edit on the relevant zones.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
# Edge proxy (docker compose --profile edge): platform base domain + cert contact
BASE_DOMAIN=localhost
ACME_EMAIL=ops@example.com
# How often the background watchdog refreshes registrar expiry dates (hours)
DOMAIN_SYNC_HOURS=24
# "Renew now" button + owner reminder email appear inside this window (days)
DOMAIN_RENEW_WINDOW_DAYS=30
# Workspace invite link lifetime (days)
INVITE_TTL_DAYS=7

# ---------- Limits ----------
MAX_UPLOAD_MB=25
MAX_FILE_CHARS=30000
CHAT_RATE_LIMIT_PER_MIN=30
MEMORY_TOP_K=6
# Cross-conversation recall (ChatMood remembers previous chats)
RECALL_TOP_K=3
RECALL_MIN_SCORE=0.38
RECENT_CHATS_DIGEST=2

# ---------- Plugins (Gmail / Google Calendar / GitHub via OAuth) ----------
# Public URL of THIS backend (OAuth callbacks land here)
BACKEND_PUBLIC_URL=http://localhost:8000
# Encryption key for stored OAuth tokens — generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLUGIN_TOKEN_KEY=
PLUGIN_MAX_CALLS=4
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Video generation (v1.9.7: comma-chain cascade) ----------
# reel = zero-key ChatMood Reel (FLUX scene stills → ffmpeg Ken Burns mp4 — works today)
# pollinations = gen.pollinations.ai video models (needs POLLINATIONS_API_KEY)
# xai = Grok video when the key has credits — e.g. VIDEO_PROVIDER=xai,reel once funded
VIDEO_PROVIDER=reel
MODEL_VIDEO=grok-video-1
POLLINATIONS_API_KEY=
POLLINATIONS_VIDEO_MODEL=wan-fast
VIDEO_MAX_WAIT_SECONDS=240
REEL_ENABLED=true
REEL_MAX_SCENES=5
# 🎞️ v1.9.8 richer reels: LLM storyboard (free Groq brain, fail-open) + AI voiceover
REEL_STORYBOARD=true
REEL_NARRATION=true
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=tara

# ---------- 🎨🎬 In-chat creation (v1.9.7) ----------
# Type "create an image of…" / "make a video of…" in any chat — generated inline.
CHAT_MEDIA=true
CHAT_IMAGE_RATE_PER_MIN=8
CHAT_VIDEO_RATE_PER_MIN=2

# ---------- Code sandbox (built-in run_python_code tool) ----------
# NOT a hardened boundary — subprocess in the backend container with rlimits + timeout.
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=8
SANDBOX_MAX_OUTPUT=6000

# ---------- ⚔️ Arena (Pro feature) ----------
# Panel models per provider — a provider only joins the arena if its API key is set.
ARENA_XAI_MODEL=            # empty → MODEL_CHAT (grok-4), also the judge
ARENA_OPENAI_MODEL=gpt-4o
ARENA_GEMINI_MODEL=gemini-2.5-pro
ARENA_CODE_MODEL=grok-code-fast-1

# ---------- 🛡 Owner / admin (see docs/ARCHITECTURE.md § owner panel) ----------
# Emails that are always admin (comma separated), in addition to users.is_admin.
ADMIN_EMAILS=
# Guaranteed owner login, created (or promoted) automatically at backend boot:
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Optional: seed a sign-up access code ("app password") — new registrations must
# supply it. Rotatable later from the owner panel (stored hashed in the DB).
APP_PASSWORD=

# ---------- Media analysis uploads ----------
MAX_AUDIO_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=50
VIDEO_ANALYSIS_FRAMES=6

# ---------- 🔴 Live streaming (Reel → Go Live, a Pro perk) ----------
# This repo does NOT host video infra. Pick a managed provider and set its keys;
# blank → Go Live reports itself unavailable instead of giving creators a dead
# Start button. Costs real money per streaming minute — see docs/REEL-PREMIUM.md.
LIVE_PROVIDER=                  # mux | cloudflare | livekit
LIVE_MAX_MINUTES=120
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ---------- 💳 Payments (manual mobile money now; gateways when keys land) ----------
CURRENCY=GHS
PRO_PRICE_MONTHLY_MINOR=15000   # 150.00 GHS — integer MINOR units (pesewas), never a float
PRO_YEAR_MONTHS=10              # yearly = 10× monthly but grants 12 → 2 months free
MANUAL_PAYMENTS_ENABLED=true    # admin publishes MoMo number → user submits ref → admin approves
PAYMENT_EXPIRY_SWEEP_HOURS=6    # how often lapsed manual plans drop back to free
# Gateways — leave blank until you have the keys. The UI lists them as
# "needs key" rather than hiding the option.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Stripe lives in the Stripe block above (STRIPE_SECRET_KEY + STRIPE_PRICE_ID).

# ---------- 🏷 Watermarking (free tier badged; paid plans + admins clean) ----------
WATERMARK_ENABLED=true
WATERMARK_TEXT=              # blank → "Made with {APP_NAME}"
WATERMARK_TIMEOUT_S=90       # cap on the stamping encode; on timeout the clean render ships

# ---------- 🗂 Projects (durable chat/file containers with a standing brief) ----------
PROJECTS_ENABLED=true
PROJECT_MAX_FILES=40          # pinned documents per project
PROJECT_MAX_PER_USER=100

# ---------- ⏰ Scheduled tasks (saved prompts ChatMood runs unattended) ----------
TASKS_ENABLED=true
# The background loop that fires due tasks. Safe to leave on for every replica:
# claiming is atomic, so two machines can never double-run the same task.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_S=60           # how often to look for due tasks
SCHEDULER_BATCH=10            # max tasks claimed per tick
SCHEDULER_RUN_TIMEOUT_S=300   # hard cap on one unattended run
TASK_MAX_PER_USER_FREE=3
TASK_MAX_PER_USER_PRO=30
TASK_RUNS_KEEP=50

# ---------- 🔑 Developer API (OpenAI-compatible, `mk_live_…` keys) ----------
PUBLIC_API_ENABLED=true
API_KEY_MAX_PER_USER=10
API_KEY_RATE_PER_MIN=60       # per key; the plan multiplier still applies

# ---------- Ops / observability ----------
# create tables automatically (dev). In production set false and run `alembic upgrade head`.
AUTO_CREATE_TABLES=true
# OpenTelemetry tracing (optional): http://<jaeger-or-collector>:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
